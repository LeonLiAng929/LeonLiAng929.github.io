@article{li2026selectrunning,
  author = {Li, Ang and Knibbe, Jarrod and Tatsuzawa, Koya and Demartini, Gianluca and Viller, Stephen and Wallis, Geoffrey and Stuerzlinger, Wolfgang and Cordeil, Maxime},
  title = {Investigating 3D Selection Performance While Running in Extended Reality: an In-depth Study of the Effect of Speed},
  year = {2026},
  journal = {IEEE Transactions on Visualization and Computer Graphics},
  publisher = {IEEE},
  doi = {10.1109/TVCG.2026.3722681},
  url = {https://doi.org/10.1109/TVCG.2026.3722681},
  note = {doi: 10.1109/TVCG.2026.3722681},
  abstract = {We explore how running speed affects target-selection performance in extended reality through a Fitts' tapping task using direct virtual touch. A controlled study with precise motion tracking examines the effects of speed, pointing phase, and foot strike on movement time, error rate, exertion, and task load.},
  keywords = {3D pointing, running, jogging, extended reality, Fitts' law},
  category = {full_paper},
  selected = {true},
  bibtex_show = {true},
  dimensions = {true},
  preview = {FittsTeaser2.png},
  video = {https://youtu.be/77m8X5KWwN4}
}

